{
  "name": "@glandjs/emitter",
  "version": "1.1.4",
  "description": "A fast, zero‑dependency event emitter for building scalable, event‑driven applications.",
  "homepage": "https://github.com/glandjs/emitter#readme",
  "author": "Mahdi <bitsgenix@gmail.com>",
  "license": "MIT",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/glandjs/emitter.git"
  },
  "files": [
    "dist/"
  ],
  "bugs": {
    "url": "https://github.com/glandjs/emitter/issues"
  },
  "sideEffects": false,
  "engines": {
    "bun": ">=1.0.0",
    "typescript": ">=5"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests",
    "bench": "bun bench/benchmark.ts",
    "pack": "npm pack",
    "verify": "bun run format:check && bun run typecheck && bun run build && bun run test",
    "prepare": "husky",
    "version": "changeset version && node scripts/changeset-version.mjs",
    "release": "npm publish",
    "release:alpha": "npm publish --tag alpha",
    "release:beta": "npm publish --tag beta"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "glandjs",
    "event",
    "event-emitter",
    "eds",
    "typescript",
    "bun"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  }
}
